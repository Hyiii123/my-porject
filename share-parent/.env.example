# 天机学堂本地 Docker 配置，仅供开发环境使用。
# 复制为 .env 后再按需修改；不要提交包含真实密码的 .env。
TJ_DOCKER_REGISTRY=docker.m.daocloud.io
# 所有 Spring Boot 服务的本地 JVM 参数；Docker Desktop 内存较小时可按需调整。
TJ_JAVA_OPTS=-Xms128m -Xmx384m
# Nacos 独立 JVM 参数。
TJ_NACOS_JVM_XMS=128m
TJ_NACOS_JVM_XMX=384m
TJ_NACOS_JVM_XMN=64m
TJ_MYSQL_ROOT_PASSWORD=TjLocalRoot@2026
TJ_MYSQL_PORT=13306
TJ_FILE_DOMAIN=/file
TJ_REDIS_PORT=6379
TJ_NACOS_PORT=8848
TJ_NACOS_GRPC_PORT=9848
TJ_NACOS_GRPC_ALT_PORT=9849
TJ_AUTH_PORT=19200
TJ_GATEWAY_PORT=8080
TJ_SYSTEM_PORT=19201
TJ_EDUCATION_PORT=19210
TJ_TRADE_PORT=19211
TJ_GEN_PORT=19202
TJ_JOB_PORT=19203
TJ_MONITOR_PORT=19100
